{
  "name": "@yamato-daiwa/universal-reactive",
  "version": "0.2.0",
  "description": "OOP-based library for frontend development.",
  "keywords": [
    "frontend"
  ],
  "author": {
    "name": "Takeshi Tokugawa",
    "email": "tokugawa.takesi@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/TokugawaTakeshi/Yamato-Daiwa-Universal-Reactive",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TokugawaTakeshi/Yamato-Daiwa-Universal-Reactive.git"
  },
  "bugs": {
    "url": "https://github.com/TokugawaTakeshi/Yamato-Daiwa-Universal-Reactive/issues",
    "email": "tokugawa.takesi@gmail.com"
  },
  "files": [
    "GeneratedTypes",
    "client.js",
    "server.js",
    "PageTemplate.hbs",
    "EmbeddedClientScript.hbs"
  ],
  "types": "./GeneratedTypes",
  "exports": {
    ".": {
      "types": "./GeneratedTypes/index.d.ts",
      "default": "./index.js"
    },
    "./server": {
      "types": "./GeneratedTypes/server.d.ts",
      "default": "./server.js"
    },
    "./client": {
      "types": "./GeneratedTypes/client.d.ts",
      "default": "./client.js"
    }
  },
  "dependencies": {
    "@yamato-daiwa/es-extensions": "1.9.3",
    "@yamato-daiwa/es-extensions-browserjs": "1.9.3",
    "@yamato-daiwa/es-extensions-nodejs": "1.9.3",
    "chokidar": "5.0.0",
    "handlebars": "4.7.10",
    "jsdom": "26.1.0"
  },
  "devDependencies": {
    "@types/jsdom": "28.0.0",
    "@types/node": "24.13.6",
    "@yamato-daiwa/automation": "../../../IntelliJ IDEA/InHouseDevelopment/YamatoDaiwaAutomation/MainPackage",
    "@yamato-daiwa/style_guides": "0.15.0",
    "nodemon": "3.1.14",
    "rimraf": "6.1.3",
    "typescript": "6.0.3"
  },
  "scripts": {
    "Lint": "eslint",
    "Run Demos": "yda build --selectiveExecution Demos --mode LOCAL_DEVELOPMENT",
    "Rebuild Distributable": "rimraf GeneratedTypes && yda build --selectiveExecution Distributable --mode PRODUCTION && tsc --project tsconfig.declarations.json --declaration --emitDeclarationOnly --outDir GeneratedTypes"
  }
}
